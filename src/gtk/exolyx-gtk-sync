#!/usr/bin/env python3
"""Synchronise les applis GTK 4 / libadwaita (GNOME Files…) avec le schéma de couleurs KDE actif.

Plasma colore les applis Qt et GTK 3, mais libadwaita ignore le thème GTK : on lui écrit
~/.config/gtk-4.0/exolyx.css (couleurs nommées + variables CSS) importé depuis gtk.css,
et on règle gsettings (sombre/clair, accent, icônes, curseur, polices).

Usage : exolyx-gtk-sync            synchronise une fois
        exolyx-gtk-sync --suivre   synchronise puis suit les changements (teintes dynamiques…)
"""
import configparser, os, re, shutil, subprocess, sys, time
from pathlib import Path

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
DONNEES = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
KDEGLOBALS = CONFIG / "kdeglobals"
GTK4 = CONFIG / "gtk-4.0"
IMPORT = '@import url("exolyx.css");'

# --- Lecture du schéma -----------------------------------------------------------------

def lire_ini(chemin):
    p = configparser.ConfigParser(interpolation=None, strict=False)
    p.optionxform = str
    try:
        p.read(chemin, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        pass
    return p

def fichier_schema(nom):
    for d in (DONNEES / "color-schemes", Path("/usr/local/share/color-schemes"), Path("/usr/share/color-schemes")):
        f = d / f"{nom}.colors"
        if f.is_file():
            return f
    return None

def couleurs():
    """Sections [Colors:*] du schéma actif : kdeglobals utilisateur, sinon fichier du schéma."""
    nom = "ExoLyx"
    for f in (KDEGLOBALS, Path("/etc/xdg/kdeglobals")):
        p = lire_ini(f)
        if p.has_option("General", "ColorScheme"):
            nom = p.get("General", "ColorScheme")
            break
    sources = [lire_ini(KDEGLOBALS)]
    f = fichier_schema(nom)
    if f:
        sources.append(lire_ini(f))
    def c(section, cle, defaut):
        for p in sources:
            if p.has_option(section, cle):
                try:
                    v = [int(x) for x in p.get(section, cle).split(",")[:3]]
                    if len(v) == 3:
                        return tuple(v)
                except ValueError:
                    pass
        return defaut
    return nom, c

def hexa(rgb):
    return "#%02x%02x%02x" % rgb

def lum(rgb):
    def l(v):
        v /= 255
        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (l(x) for x in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def melange(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))

# --- Production du CSS -------------------------------------------------------------------

def palette():
    nom, c = couleurs()
    fen = c("Colors:Window", "BackgroundNormal", (13, 19, 16))
    texte = c("Colors:Window", "ForegroundNormal", (230, 239, 225))
    sombre = lum(fen) < 0.25
    vue = c("Colors:View", "BackgroundNormal", fen)
    entete = c("Colors:Header", "BackgroundNormal", c("Colors:Window", "BackgroundAlternate", fen))
    bouton = c("Colors:Button", "BackgroundNormal", fen)
    accent = c("Colors:Selection", "BackgroundNormal", (168, 212, 121))
    sur_accent = c("Colors:Selection", "ForegroundNormal", (13, 19, 16))
    rouge = c("Colors:View", "ForegroundNegative", (229, 118, 107))
    jaune = c("Colors:View", "ForegroundNeutral", (232, 194, 106))
    vert = c("Colors:View", "ForegroundPositive", (141, 212, 121))
    lien = c("Colors:View", "ForegroundLink", accent)
    # La barre latérale est un peu plus marquée que la fenêtre, comme dans Plasma
    laterale = melange(fen, texte, 0.035 if sombre else 0.02)
    carte = melange(vue, texte, 0.05 if sombre else 0.0)
    return nom, sombre, {
        "accent_color": lien, "accent_bg_color": accent, "accent_fg_color": sur_accent,
        "destructive_color": rouge, "destructive_bg_color": rouge, "destructive_fg_color": (255, 255, 255),
        "success_color": vert, "success_bg_color": vert, "success_fg_color": sur_accent,
        "warning_color": jaune, "warning_bg_color": jaune, "warning_fg_color": (0, 0, 0),
        "error_color": rouge, "error_bg_color": rouge, "error_fg_color": (255, 255, 255),
        "window_bg_color": fen, "window_fg_color": texte,
        "view_bg_color": vue, "view_fg_color": texte,
        "headerbar_bg_color": entete, "headerbar_fg_color": texte,
        "headerbar_backdrop_color": fen, "headerbar_border_color": texte,
        "sidebar_bg_color": laterale, "sidebar_fg_color": texte, "sidebar_backdrop_color": laterale,
        "secondary_sidebar_bg_color": melange(laterale, fen, 0.5), "secondary_sidebar_fg_color": texte,
        "card_bg_color": carte, "card_fg_color": texte,
        "dialog_bg_color": bouton, "dialog_fg_color": texte,
        "popover_bg_color": bouton, "popover_fg_color": texte,
        "thumbnail_bg_color": carte, "thumbnail_fg_color": texte,
    }

def css(nom, sombre, p):
    lignes = [f"/* Généré par exolyx-gtk-sync depuis le schéma KDE « {nom} ». Ne pas modifier. */"]
    lignes += [f"@define-color {k} {hexa(v)};" for k, v in p.items()]
    # libadwaita ≥ 1.6 : variables CSS
    lignes.append(":root {")
    lignes += [f"  --{k.replace('_color', '').replace('_', '-')}-color: {hexa(v)};" for k, v in p.items()]
    lignes.append("}")
    return "\n".join(lignes) + "\n"

def ecrire_gtk(contenu):
    GTK4.mkdir(parents=True, exist_ok=True)
    cible = GTK4 / "exolyx.css"
    if not cible.exists() or cible.read_text() != contenu:
        cible.write_text(contenu)
    # gtk.css : on garde ce que Plasma y écrit (imports) et on ajoute le nôtre en dernier
    gtkcss = GTK4 / "gtk.css"
    try:
        actuel = gtkcss.read_text() if not gtkcss.is_symlink() else ""
    except OSError:
        actuel = ""
    lignes = [l for l in actuel.splitlines() if l.strip() != IMPORT]
    imports = [l for l in lignes if l.lstrip().startswith("@import")]
    reste = [l for l in lignes if not l.lstrip().startswith("@import")]
    nouveau = "\n".join(imports + [IMPORT] + reste).rstrip() + "\n"
    if gtkcss.is_symlink():
        gtkcss.unlink()
    if actuel != nouveau:
        gtkcss.write_text(nouveau)

# --- gsettings ----------------------------------------------------------------------------

def kde(groupe, cle, defaut):
    for f in (KDEGLOBALS, Path("/etc/xdg/kdeglobals")):
        p = lire_ini(f)
        if p.has_option(groupe, cle):
            return p.get(groupe, cle)
    return defaut

def regler_gsettings(sombre, accent):
    if not shutil.which("gsettings"):
        return
    # Accent libadwaita : préréglage le plus proche de la teinte KDE
    import colorsys
    h, l, s = colorsys.rgb_to_hls(*(x / 255 for x in accent))
    teintes = [("red", 0), ("orange", 30), ("yellow", 50), ("green", 110), ("teal", 175),
               ("blue", 215), ("purple", 275), ("pink", 330), ("red", 360)]
    nom_accent = "slate" if s < 0.15 else min(teintes, key=lambda t: abs(t[1] - h * 360))[0]
    police = kde("General", "font", "Inter,10").split(",")
    fixe = kde("General", "fixed", "JetBrains Mono,10").split(",")
    reglages = {
        "color-scheme": "prefer-dark" if sombre else "default",
        "accent-color": nom_accent,
        "icon-theme": kde("Icons", "Theme", "ExoLyx-Duo"),
        "font-name": f"{police[0]} {police[1] if len(police) > 1 else 10}",
        "monospace-font-name": f"{fixe[0]} {fixe[1] if len(fixe) > 1 else 10}",
    }
    curseur = lire_ini(CONFIG / "kcminputrc")
    reglages["cursor-theme"] = curseur.get("Mouse", "cursorTheme", fallback="ExoLyx-Curseur")
    for cle, val in reglages.items():
        r = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", cle],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip().strip("'") != val:
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", cle, val],
                           capture_output=True)

def synchroniser():
    nom, sombre, p = palette()
    ecrire_gtk(css(nom, sombre, p))
    regler_gsettings(sombre, p["accent_bg_color"])

def empreinte():
    t = []
    for f in (KDEGLOBALS, CONFIG / "kcminputrc", GTK4 / "gtk.css"):
        try:
            t.append(f.stat().st_mtime_ns)
        except OSError:
            t.append(0)
    return tuple(t)

def main():
    synchroniser()
    if "--suivre" in sys.argv:
        avant = empreinte()
        while True:
            time.sleep(2)
            maintenant = empreinte()
            if maintenant != avant:
                time.sleep(0.5)  # laisser Plasma finir d'écrire
                try:
                    synchroniser()
                except Exception as e:  # ne jamais tuer le service pour une erreur ponctuelle
                    print("exolyx-gtk-sync :", e, file=sys.stderr)
                avant = empreinte()

if __name__ == "__main__":
    main()
