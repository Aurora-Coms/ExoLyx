/* SPDX-License-Identifier: GPL-3.0-or-later
 * Feuille de style Calamares d'ExoLyx — vert pomme sur fond sombre.
 * Couleurs : src/branding/palette.md (sombre).
 */

/* Fenêtre principale */
#mainApp, QDialog {
    background-color: #0D1310;
    color: #E6EFE1;
    font-family: "Inter";
}

QWidget {
    color: #E6EFE1;
    font-family: "Inter";
    selection-background-color: #A8D479;
    selection-color: #0D1310;
}

QLabel { background: transparent; }

/* Barre latérale */
#sidebarApp {
    background-color: #0D1310;
    border-right: 1px solid #2A362E;
}
#sidebarMenuApp {
    background-color: #0D1310;
    padding: 4px;
}
#logoApp { padding: 12px; }

/* Boutons */
QPushButton {
    background-color: #1C2620;
    color: #E6EFE1;
    border: 1px solid #2A362E;
    border-radius: 6px;
    padding: 7px 16px;
    min-height: 20px;
}
QPushButton:hover { border-color: #A8D479; background-color: #222E27; }
QPushButton:pressed { background-color: #141C17; }
QPushButton:disabled { color: #5C6A59; border-color: #1C2620; }
QPushButton:default, #view-button-next {
    background-color: #A8D479;
    color: #0D1310;
    border: 1px solid #A8D479;
    font-weight: 600;
}
QPushButton:default:hover, #view-button-next:hover { background-color: #BDD479; }

/* Champs de saisie */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit, QListView, QTreeView, QTableView {
    background-color: #141C17;
    color: #E6EFE1;
    border: 1px solid #2A362E;
    border-radius: 6px;
    padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #A8D479; }
QComboBox QAbstractItemView {
    background-color: #141C17;
    border: 1px solid #2A362E;
    selection-background-color: #A8D479;
    selection-color: #0D1310;
}
QListView::item:selected, QTreeView::item:selected {
    background-color: #A8D479;
    color: #0D1310;
}
QListView::item:hover, QTreeView::item:hover { background-color: #1C2620; }

QHeaderView::section {
    background-color: #1C2620;
    color: #97A893;
    border: none;
    padding: 4px;
}

/* Cases et boutons radio */
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }

/* Barre de progression */
QProgressBar {
    background-color: #1C2620;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #E6EFE1;
}
QProgressBar::chunk {
    background-color: #A8D479;
    border-radius: 6px;
}

/* Barres de défilement */
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #2A362E; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #A8D479; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #2A362E; border-radius: 5px; min-width: 30px; }

QToolTip {
    background-color: #1C2620;
    color: #E6EFE1;
    border: 1px solid #A8D479;
    border-radius: 6px;
    padding: 4px;
}

QGroupBox {
    border: 1px solid #2A362E;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #A8D479; }
