# SPDX-License-Identifier: GPL-3.0-or-later
# Branding Calamares 3.3 d'ExoLyx — /usr/share/calamares/branding/exolyx/
---
componentName: exolyx

# Page d'accueil « Calamares » (image productWelcome + boutons de liens).
welcomeStyleCalamares: true
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 1100px,700px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName:         "ExoLyx"
    shortProductName:    "ExoLyx"
    version:             "1.0.0"
    shortVersion:        "1.0"
    versionedName:       "ExoLyx 1.0"
    shortVersionedName:  "ExoLyx 1.0"
    bootloaderEntryName: "ExoLyx"
    productUrl:          "https://github.com/Aurora-Coms/ExoLyx"
    supportUrl:          "https://github.com/Aurora-Coms/ExoLyx/discussions"
    knownIssuesUrl:      "https://github.com/Aurora-Coms/ExoLyx/issues"
    releaseNotesUrl:     "https://github.com/Aurora-Coms/ExoLyx/releases"
    donateUrl:           ""

images:
    productLogo:    "logo.png"
    productIcon:    "icone.png"
    productWelcome: "bienvenue.png"

# Diaporama QML autonome (API 2 : fonctions onActivate()/onLeave()).
slideshow:    "show.qml"
slideshowAPI: 2

# Couleurs de la barre latérale.
# Noms Calamares 3.3 (SidebarXxx) ; les anciens noms (sidebarXxx, ≤ 3.2)
# sont répétés en dessous : ignorés par la 3.3, utiles si une version
# plus ancienne lit ce fichier.
style:
    SidebarBackground:        "#0D1310"
    SidebarText:              "#E6EFE1"
    SidebarTextCurrent:       "#0D1310"
    SidebarBackgroundCurrent: "#A8D479"
    sidebarBackground:        "#0D1310"
    sidebarText:              "#E6EFE1"
    sidebarTextSelect:        "#0D1310"
    sidebarTextHighlight:     "#A8D479"
