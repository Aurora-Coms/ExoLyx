<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<policyconfig>
  <vendor>ExoLyx</vendor>
  <vendor_url>https://github.com/Aurora-Coms/ExoLyx</vendor_url>
  <icon_name>system-software-install</icon_name>
  <action id="org.exolyx.helper">
    <description>Install drivers and applications from the ExoLyx welcome app</description>
    <description xml:lang="fr">Installer des pilotes et des applications depuis l'appli de bienvenue ExoLyx</description>
    <message>Authentication is required to install software</message>
    <message xml:lang="fr">Une authentification est nécessaire pour installer des logiciels</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/exolyx/exolyx-helper</annotate>
  </action>
</policyconfig>
