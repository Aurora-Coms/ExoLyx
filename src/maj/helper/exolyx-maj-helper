"""exolyx-maj-helper — mise à jour complète du système ExoLyx.

Appelé via pkexec (action polkit org.exolyx.maj). Une seule action, sans
aucun argument libre :

    pkexec /usr/lib/exolyx/exolyx-maj-helper mettre-a-jour
    exolyx-maj-helper mettre-a-jour --simulation      (essai, sans root)

Exécute « pacman -Syu --noconfirm » (snap-pac crée les instantanés avant/après).
Dernière ligne : « @@FIN <code> » (0 succès, 2 refus, 3 pas root,
4 base verrouillée, sinon code de pacman).
"""
import os
import subprocess
import sys
import time

ACTIONS = {"mettre-a-jour"}
COMMANDE = ["pacman", "-Syu", "--noconfirm", "--noprogressbar"]
ENV_PROPRE = {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin",
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "HOME": "/root",
}
SIMULATION = """:: Synchronizing package databases...
 core downloading...
 extra downloading...
:: Starting full system upgrade...
resolving dependencies...
looking for conflicting packages...

Packages (3) firefox-133.0-1  linux-6.12.4.arch1-1  mesa-1:24.3.1-1

Total Download Size:   182.40 MiB
Total Installed Size:  412.10 MiB
Net Upgrade Size:        2.31 MiB

:: Proceed with installation? [Y/n]
:: Retrieving packages...
 firefox-133.0-1-x86_64 downloading...
 linux-6.12.4.arch1-1-x86_64 downloading...
 mesa-1:24.3.1-1-x86_64 downloading...
checking keyring...
(3/3) checking keys in keyring
(3/3) checking package integrity
(3/3) loading package files
(3/3) checking for file conflicts
(3/3) checking available disk space
:: Running pre-transaction hooks...
(1/1) Performing snapper pre snapshots for the following configurations...
==> root: 42
:: Processing package changes...
(1/3) upgrading firefox
(2/3) upgrading linux
(3/3) upgrading mesa
:: Running post-transaction hooks...
(1/4) Arming ConditionNeedsUpdate...
(2/4) Updating module dependencies...
(3/4) Updating linux initcpios...
(4/4) Performing snapper post snapshots for the following configurations...
==> root: 43"""


def valider(argv):
    """Renvoie (action, simulation) ou lève ValueError."""
    args = list(argv)
    simulation = "--simulation" in args
    if simulation:
        args.remove("--simulation")
    if len(args) != 1 or args[0] not in ACTIONS:
        raise ValueError("requête refusée : seule l'action « mettre-a-jour » est permise, sans argument")
    return args[0], simulation


def main(argv):
    try:
        _action, simulation = valider(argv)
    except ValueError as e:
        print(e, flush=True)
        print("@@FIN 2", flush=True)
        return 2
    if simulation:
        for ligne in SIMULATION.splitlines():
            print(ligne, flush=True)
            time.sleep(0.04)
        print("@@FIN 0", flush=True)
        return 0
    if os.geteuid() != 0:
        print("Ce programme doit être lancé via pkexec.", flush=True)
        print("@@FIN 3", flush=True)
        return 3
    if os.path.exists("/var/lib/pacman/db.lck"):
        print("La base pacman est verrouillée : une autre installation est en cours.", flush=True)
        print("@@FIN 4", flush=True)
        return 4
    print("$ " + " ".join(COMMANDE), flush=True)
    proc = subprocess.Popen(COMMANDE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, env=ENV_PROPRE, text=True,
                            errors="replace", bufsize=1)
    for ligne in proc.stdout:
        print(ligne.rstrip("\n"), flush=True)
    code = proc.wait()
    print(f"@@FIN {code}", flush=True)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
